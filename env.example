# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/node_booking?schema=public"
HOST_TIMEZONE=America/Mexico_City

# Auth.js (configured in phase 4)
AUTH_SECRET=replace-with-a-32-byte-base64-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_ALLOWED_EMAILS=admin@node.mx

# Google Calendar (configured in phase 4)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_WEBHOOK_TOKEN=replace-with-random-secret
GOOGLE_WEBHOOK_URL=http://localhost:3000/api/google/webhook
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Resend (configured in phase 6)
RESEND_API_KEY=
EMAIL_FROM="NODE <agenda@node.mx>"

# Cloudflare Turnstile (configured in phase 3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Jobs and rate limiting (configured in phases 7 and 9)
CRON_SECRET=replace-with-random-secret
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
